# Copy to .env.local in this directory. Obtain development credentials from the team lead.
# These empty values are a checklist, not a working database or email configuration.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google OAuth callback: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link login and email blasts use separate configuration names.
AUTH_RESEND_KEY=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Use the development project's browser-safe anon key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obtain a development analytics project if exercising telemetry.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional source-map upload in CI only.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=

# Disposable loopback PostgreSQL only. Non-loopback databases require SSL.
# DATABASE_SSL=disable
# Tests refuse any other database name or non-loopback host.
# POS_TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:55439/lattelab_pos_integration
